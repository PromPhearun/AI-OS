{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.dev/schemas/agent.schema.json",
  "title": "AI OS Agent Spec",
  "description": "Canonical agent specification document. Validated at spawn; the spec IS the capability list.",
  "type": "object",
  "required": ["name", "llm"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "description": "Unique agent name; also the key of the registered @agent definition."
    },
    "version": { "type": "string", "default": "1" },
    "description": { "type": "string", "maxLength": 500 },
    "role": {
      "type": "string",
      "enum": ["operator", "standard", "restricted", "service"],
      "default": "standard",
      "description": "RBAC role (docs/08-security.md §2). Effective permissions = role base capabilities ∪ spec-declared grants."
    },
    "env": {
      "type": "object",
      "additionalProperties": false,
      "description": "Vault key grants for get_env (docs/08-security.md §5). Deny-by-default: a key not listed here returns E_PERM.",
      "properties": {
        "allowed_keys": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "default": [],
          "description": "Secret keys this agent may resolve via get_env (values never enter context/logs/checkpoints)."
        }
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "description": "Approval-ticket policy (docs/08-security.md §3).",
      "properties": {
        "max_pending": {
          "type": "integer",
          "minimum": 0,
          "default": 3,
          "description": "Max concurrent pending request_permission tickets."
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "description": "Sandbox profile for this agent (docs/08-security.md §4).",
      "properties": {
        "profile": {
          "type": "string",
          "enum": ["inprocess", "subprocess", "container"],
          "default": "subprocess"
        },
        "network": {
          "type": "string",
          "enum": ["none", "http", "all"],
          "default": "none"
        },
        "rlimits": {
          "type": "object",
          "description": "Subprocess resource limits (e.g. {'max_cpu_s': 5, 'max_mem_mb': 256})."
        }
      }
    },
    "entry": { "type": "string", "description": "Python import path of the agent definition module (future)." },
    "group_id": { "type": "string", "default": "default" },
    "priority": {
      "type": "integer", "minimum": -20, "maximum": 20, "default": 0,
      "description": "Scheduler priority; higher runs first."
    },
    "llm": {
      "type": "object",
      "required": ["model"],
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string", "default": "mock" },
        "system": { "type": "string" },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2, "default": 0.0 },
        "max_tokens": { "type": "integer", "minimum": 1 }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokens_per_min": { "type": "integer", "minimum": 0, "default": 0 },
        "cost_per_hour_usd": { "type": "number", "minimum": 0, "default": 0 },
        "max_wall_clock_s": { "type": "number", "minimum": 0, "default": 0 },
        "max_tool_calls": { "type": "integer", "minimum": 0, "default": 0 },
        "max_turns": { "type": "integer", "minimum": 1, "default": 50 }
      }
    },
    "ipc": {
      "type": "object",
      "additionalProperties": false,
      "description": "IPC capability grants (docs/06-ipc.md). Deny-by-default: omitting 'ipc' forbids all IPC.",
      "properties": {
        "can_send_to": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(\\*|group:[a-z0-9_-]+|pid:[0-9]+)$"
          },
          "default": [],
          "description": "Recipients this agent may send_msg to: '*' (any), 'group:<id>', or 'pid:<n>'."
        },
        "can_subscribe": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": [],
          "description": "Topic patterns this agent may subscribe to ('*', exact, or 'prefix.*')."
        },
        "can_publish": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": [],
          "description": "Topic patterns this agent may publish to."
        },
        "mailbox": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_queue_depth": { "type": "integer", "minimum": 1, "default": 100 },
            "ttl_s": { "type": "number", "minimum": 0, "default": 3600 }
          }
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "description": "L3 long-term memory grants (docs/04-memory.md §5). Deny-by-default: pools not listed here are unreachable (E_PERM).",
      "properties": {
        "pools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["pool", "access"],
            "additionalProperties": false,
            "properties": {
              "pool": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
              "access": { "enum": ["read", "read-write"] }
            }
          },
          "default": []
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "description": "L1 context-window policy (docs/04-memory.md §2). Omitting context_token_budget disables automatic summarization.",
      "properties": {
        "context_token_budget": { "type": "integer", "minimum": 1 },
        "keep_recent_messages": { "type": "integer", "minimum": 1, "default": 4 }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "args": {
                "type": "object",
                "description": "Per-tool grant configuration (e.g. shell.run allow_commands)."
              },
              "approved": { "type": "boolean", "default": true },
              "needs_approval": {
                "type": "boolean",
                "default": false,
                "description": "Route this tool through request_permission before execution (docs/07-tools.md §7)."
              }
            }
          }
        },
        "spawn": {
          "type": "boolean",
          "default": false,
          "description": "Allow this agent to spawn children via the `spawn` syscall (deny by default)."
        },
        "operator": {
          "type": "boolean",
          "default": false,
          "description": "Operator privileges: approve/deny tickets, register MCP servers, verify the audit log."
        },
        "memory": { "type": "boolean", "default": true, "description": "Allow L2 working-memory syscalls." },
        "context": { "type": "boolean", "default": true, "description": "Allow context read/append syscalls." }
      }
    }
  }
}