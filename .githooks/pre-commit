#!/bin/bash

# Repo-local TruffleHog pre-commit hook — faithful copy of the company hook
# (/opt/skel/.git/hooks/pre-commit) with one addition: an allowlist file
# (.trufflehog-exclude) is passed via --exclude-paths so intentional test
# fixtures that trip detectors are suppressible without bypassing the scan.
# Everything else — including --fail on findings — is unchanged.

# Skip pre-commit if git commit is from Cline
username=$(git config user.name)
if [ "$username" == "Cline Checkpoint" ]
then
    exit 0
fi

#checking absolute paths
if command -v trufflehog &> /dev/null; then
    trufflehog_path="trufflehog"
elif [[ -x /usr/local/bin/trufflehog ]]; then
    trufflehog_path="/usr/local/bin/trufflehog"
elif [[ -x /opt/homebrew/bin/trufflehog ]]; then
    trufflehog_path="/opt/homebrew/bin/trufflehog"
else
    echo "Trufflehog is not setup. Please run ** brew install trufflehog ** to install it or connect with Product Security team"
    exit 1
fi

# Only pass the allowlist when the file exists (fresh clones without it scan everything).
exclude_args=()
if [ -f .trufflehog-exclude ]; then
    exclude_args=(--exclude-paths .trufflehog-exclude)
fi

# Use `filesysytem` if the git repo does not have any commits i.e its a new git repo.
if git log -1 > /dev/null 2>&1; then
    $trufflehog_path git file://. --no-update --since-commit HEAD --fail --trust-local-git-config "${exclude_args[@]}" >> /tmp/trufflehog_output_$(whoami) 2>&1
    trufflehog_exit_code=$?
else
    $trufflehog_path filesystem . --no-update --fail "${exclude_args[@]}" >> /tmp/trufflehog_output_$(whoami) 2>&1
    trufflehog_exit_code=$?
fi

# Only display results to stdout if trufflehog found something.
if [ $trufflehog_exit_code -eq 183 ]; then
    cat /tmp/trufflehog_output_$(whoami)
    echo "TruffleHog found secrets. Aborting commit. use --no-verify to bypass it"
    exit $trufflehog_exit_code
fi